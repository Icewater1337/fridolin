{
  "_comment": "A config as versions before the legacy removal wrote it: the retired keys model, work_dir, brain_mode and an empty brains list. Synthetic values only.",
  "agent_provider": "claude",
  "allow_any_dm": false,
  "allowed_groups": [],
  "allowed_numbers": [
    "15551234567"
  ],
  "backup": {
    "daily_at": "03:30",
    "enabled": false,
    "include_bridge_config": true,
    "keep_versions_days": 30,
    "remote": "brain-gdrive",
    "root": "fridolin-backup"
  },
  "brain_mode": true,
  "brain_model": "opus",
  "claude_path": "claude",
  "codex_effort": "high",
  "codex_model": "gpt-6.1-sol",
  "codex_path": "codex",
  "core": {
    "lease": {
      "enabled": false,
      "renew_seconds": 300,
      "stale_seconds": 1200
    },
    "memory_limit_gb": 8,
    "tailnet": {
      "enabled": false,
      "hostname": "fridolin-core"
    }
  },
  "dangerously_skip_permissions": false,
  "dashboard": {
    "require_token": true
  },
  "data_dir": "<HOME>/.fridolin",
  "db_path": "<HOME>/.fridolin/bridge.db",
  "debounce": {
    "max_wait_ms": 10000,
    "quiet_ms": 2000
  },
  "fride": {
    "news": "quiet"
  },
  "housekeeping": {
    "cpu_percent": 80,
    "dry_run": true,
    "enabled": true,
    "every_hours": 48,
    "min_age_minutes": 60,
    "rss_mb": 2048
  },
  "http_listen": "127.0.0.1:8765",
  "ingest": {
    "enabled": false
  },
  "log_level": "info",
  "max_chunk_size": 3900,
  "max_concurrent_runs": 2,
  "max_media_mb": 100,
  "media_dir": "<HOME>/.fridolin/media",
  "nodes": {
    "enabled": false,
    "listen": ":8766"
  },
  "otp_guard": true,
  "plaud": {
    "enabled": false
  },
  "policy": {
    "approval_timeout_hours": 24,
    "max_pending_irreversible": 3,
    "max_runs_per_hour": 20
  },
  "queue": {
    "max_pending": 10,
    "mode": "queue",
    "notify": true
  },
  "run_timeout_minutes": 30,
  "sandbox": {
    "allow_paths": [],
    "deny_paths": [],
    "enabled": false,
    "git_config": "read"
  },
  "schedules": {
    "enabled": true,
    "jitter_minutes": 2,
    "keep_days": 30,
    "keep_runs": 100,
    "max_log_kb": 1024,
    "max_total_mb": 200
  },
  "script_api": {
    "tokenless_send": true
  },
  "startup_checks": {},
  "triggers": [
    "@claude"
  ],
  "vault": {
    "activity_days": 60,
    "b2_daily_budget": 2000,
    "bucket": "fridolin-vault",
    "cold_after_days": 90,
    "enabled": false,
    "endpoint": "s3.eu-central-003.backblazeb2.com",
    "headroom_percent": 10,
    "hot_budget_gb": 50,
    "secret_keep_days": 30,
    "snapshots_bucket": "fridolin-snapshots"
  },
  "version": 2,
  "viewer": false
}
