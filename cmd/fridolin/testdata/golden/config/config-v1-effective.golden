{
  "_comment": "A config with every setting this version reads, for the tests. Synthetic values only.",
  "agent_provider": "claude",
  "allow_any_dm": false,
  "allowed_groups": [
    "120363000000000000@g.us",
    "120363000000000001@g.us"
  ],
  "allowed_numbers": [
    "15551234567",
    "15559876543"
  ],
  "backup": {
    "daily_at": "04:15",
    "enabled": true,
    "include_bridge_config": false,
    "include_secret_files": true,
    "keep_versions_days": 14,
    "rclone_path": "<HOME>/bin/rclone",
    "remote": "brain-gdrive",
    "root": "fridolin-backup"
  },
  "brain_dirs": [
    {
      "approved": {
        "backup": {
          "enabled": true,
          "exclude": [
            "node_modules/"
          ]
        },
        "id": "main",
        "name": "Main",
        "prompt_file": "brain-prompt.md",
        "routing": {
          "default": true,
          "groups": [
            "120363000000000000@g.us"
          ],
          "handles_dms": true
        },
        "version": 1
      },
      "moved_from": "~/main",
      "path": "<HOME>/brains/main"
    }
  ],
  "brain_effort": "high",
  "brain_mode": true,
  "brain_model": "sonnet",
  "child_env_passthrough": [
    "GROQ_API_KEY"
  ],
  "claude_path": "<HOME>/bin/claude",
  "codex_effort": "high",
  "codex_model": "gpt-6.1-sol",
  "codex_path": "codex",
  "connections": {
    "elevenlabs": {
      "brain_monthly_usd": 5,
      "brains": [
        "main"
      ],
      "voice": "21m00Tcm4TlvDq8ikWAM"
    },
    "openai": {
      "brain_monthly_usd": 10,
      "brains": [
        "main"
      ]
    }
  },
  "core": {
    "lease": {
      "enabled": true,
      "renew_seconds": 30,
      "stale_seconds": 180
    },
    "memory_limit_gb": 6,
    "tailnet": {
      "enabled": true,
      "hostname": "fridolin-test-core"
    }
  },
  "dangerously_skip_permissions": true,
  "dashboard": {
    "require_token": true
  },
  "data_dir": "<HOME>/.fridolin",
  "db_path": "<HOME>/.fridolin/bridge.db",
  "debounce": {
    "max_wait_ms": 8000,
    "quiet_ms": 1500
  },
  "disallowed_tools": [
    "WebFetch"
  ],
  "fride": {
    "instances": {
      "work": {
        "core_login": true,
        "description": "work repositories",
        "egress": [
          "registry.example.com"
        ],
        "identities": [
          "gitlab"
        ],
        "idle_stop_minutes": 45,
        "memory_mb": 8192,
        "nodes": [
          "mini"
        ],
        "repos": [
          "https://gitlab.example.com/group/app.git"
        ]
      }
    },
    "news": "all"
  },
  "group_members": {
    "120363000000000000@g.us": [
      "15551234567",
      "15559876543"
    ]
  },
  "housekeeping": {
    "cpu_percent": 90,
    "dry_run": false,
    "enabled": true,
    "every_hours": 24,
    "min_age_minutes": 30,
    "rss_mb": 4096
  },
  "http_listen": "127.0.0.1:8765",
  "ingest": {
    "enabled": true
  },
  "log_level": "debug",
  "max_chunk_size": 2000,
  "max_concurrent_runs": 3,
  "max_media_mb": 50,
  "media_dir": "<HOME>/.fridolin/media",
  "nodes": {
    "enabled": true,
    "git_identities": {
      "mini": [
        "github"
      ]
    },
    "listen": "127.0.0.1:9766"
  },
  "otp_guard": true,
  "otp_markers": [
    "verification code"
  ],
  "plaud": {
    "brain": "main",
    "brain_access": true,
    "cli_path": "~/bin/plaud",
    "enabled": true,
    "interval_seconds": 120,
    "message": "[Plaud] {name} ({when}, {duration})",
    "phone_dir": "<HOME>/PlaudSync",
    "phone_upload": true,
    "polished": true,
    "voice": true,
    "voice_brain": "main",
    "voice_quiet": true
  },
  "policy": {
    "approval_timeout_hours": 12,
    "max_pending_irreversible": 2,
    "max_runs_per_hour": 30
  },
  "queue": {
    "max_pending": 5,
    "mode": "interrupt",
    "notify": false
  },
  "run_timeout_minutes": 45,
  "sandbox": {
    "allow_paths": [
      "<HOME>/Documents/shared"
    ],
    "credentials_dir": "<HOME>/.fridolin/credentials",
    "deny_paths": [
      "<HOME>/clients"
    ],
    "enabled": false,
    "git_config": "deny"
  },
  "schedules": {
    "enabled": true,
    "jitter_minutes": 5,
    "keep_days": 14,
    "keep_runs": 50,
    "max_log_kb": 512,
    "max_total_mb": 100
  },
  "script_api": {
    "tokenless_send": false
  },
  "startup_checks": {
    "hint": "Restore the credentials from the backup.",
    "notify_jid": "15551234567@s.whatsapp.net",
    "notify_whatsapp": true,
    "required_files": [
      "<HOME>/.fridolin/credentials/google_calendar_token_main.json"
    ]
  },
  "timezone": "Europe/Zurich",
  "triggers": [
    "@claude",
    {
      "match": "start",
      "text": "!bot"
    },
    {
      "match": "word",
      "text": "assistant"
    }
  ],
  "vault": {
    "activity_days": 45,
    "b2_daily_budget": 1500,
    "bucket": "example-vault",
    "cold_after_days": 120,
    "enabled": true,
    "endpoint": "s3.example-region.backblazeb2.com",
    "headroom_percent": 15,
    "hot_budget_gb": 40,
    "secret_dirs": [
      "<HOME>/.personal-calendar"
    ],
    "secret_keep_days": 45,
    "snapshots_bucket": "example-snapshots",
    "targets": [
      {
        "check_days": 3,
        "folder": "/Volumes/Backup/fridolin",
        "hourly": true,
        "include_data_dir": true,
        "kind": "node",
        "name": "nas",
        "nightly_at": "02:30",
        "node": "0123456789ab",
        "read_data_days": 14,
        "retention": {
          "daily": 7,
          "hourly": 12,
          "monthly": 6,
          "weekly": 4
        },
        "window_hours": 30
      }
    ]
  },
  "version": 3,
  "viewer": false
}
