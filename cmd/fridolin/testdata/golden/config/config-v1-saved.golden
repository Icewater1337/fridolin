{
  "_comment": "A config with every setting this version reads, for the tests. Synthetic values only.",
  "version": 2,
  "allowed_numbers": [
    "15551234567",
    "15559876543"
  ],
  "allow_any_dm": false,
  "allowed_groups": [
    "120363000000000000@g.us",
    "120363000000000001@g.us"
  ],
  "group_members": {
    "120363000000000000@g.us": [
      "15551234567",
      "15559876543"
    ]
  },
  "triggers": [
    "@claude",
    {
      "text": "!bot",
      "match": "start"
    },
    {
      "text": "assistant",
      "match": "word"
    }
  ],
  "claude_path": "~/bin/claude",
  "agent_provider": "claude",
  "codex_path": "codex",
  "codex_model": "gpt-6.1-sol",
  "codex_effort": "high",
  "data_dir": "~/.fridolin",
  "db_path": "~/.fridolin/bridge.db",
  "media_dir": "~/.fridolin/media",
  "max_chunk_size": 2000,
  "max_media_mb": 50,
  "brain_model": "sonnet",
  "brain_effort": "high",
  "disallowed_tools": [
    "WebFetch"
  ],
  "dangerously_skip_permissions": true,
  "run_timeout_minutes": 45,
  "max_concurrent_runs": 3,
  "child_env_passthrough": [
    "GROQ_API_KEY"
  ],
  "http_listen": "127.0.0.1:8765",
  "log_level": "debug",
  "brain_mode": true,
  "brain_dirs": [
    {
      "path": "~/brains/main",
      "approved": {
        "version": 1,
        "id": "main",
        "name": "Main",
        "routing": {
          "handles_dms": true,
          "default": true,
          "groups": [
            "120363000000000000@g.us"
          ]
        },
        "prompt_file": "brain-prompt.md",
        "backup": {
          "enabled": true,
          "exclude": [
            "node_modules/"
          ]
        }
      },
      "moved_from": "~/main"
    }
  ],
  "sandbox": {
    "enabled": false,
    "deny_paths": [
      "~/clients"
    ],
    "allow_paths": [
      "~/Documents/shared"
    ],
    "git_config": "deny",
    "credentials_dir": "~/.fridolin/credentials"
  },
  "otp_guard": true,
  "otp_markers": [
    "verification code"
  ],
  "viewer": false,
  "queue": {
    "mode": "interrupt",
    "max_pending": 5,
    "notify": false
  },
  "debounce": {
    "quiet_ms": 1500,
    "max_wait_ms": 8000
  },
  "ingest": {
    "enabled": true
  },
  "startup_checks": {
    "required_files": [
      "~/.fridolin/credentials/google_calendar_token_main.json"
    ],
    "notify_whatsapp": true,
    "notify_jid": "15551234567@s.whatsapp.net",
    "hint": "Restore the credentials from the backup."
  },
  "backup": {
    "enabled": true,
    "remote": "brain-gdrive",
    "root": "fridolin-backup",
    "daily_at": "04:15",
    "rclone_path": "~/bin/rclone",
    "keep_versions_days": 14,
    "include_bridge_config": false,
    "include_secret_files": true
  },
  "plaud": {
    "enabled": true,
    "brain": "main",
    "cli_path": "~/bin/plaud",
    "interval_seconds": 120,
    "polished": true,
    "message": "[Plaud] {name} ({when}, {duration})",
    "brain_access": true,
    "phone_dir": "~/PlaudSync",
    "phone_upload": true
  },
  "dashboard": {
    "require_token": true
  },
  "script_api": {
    "tokenless_send": false
  },
  "core": {
    "tailnet": {
      "enabled": true,
      "hostname": "fridolin-test-core"
    },
    "lease": {
      "enabled": true,
      "renew_seconds": 30,
      "stale_seconds": 180
    },
    "memory_limit_gb": 6
  },
  "vault": {
    "enabled": true,
    "hot_budget_gb": 40,
    "activity_days": 45,
    "cold_after_days": 120,
    "headroom_percent": 15,
    "bucket": "example-vault",
    "snapshots_bucket": "example-snapshots",
    "endpoint": "s3.example-region.backblazeb2.com",
    "b2_daily_budget": 1500,
    "targets": [
      {
        "name": "nas",
        "kind": "node",
        "node": "0123456789ab",
        "folder": "/Volumes/Backup/fridolin",
        "nightly_at": "02:30",
        "hourly": true,
        "include_data_dir": true,
        "retention": {
          "hourly": 12,
          "daily": 7,
          "weekly": 4,
          "monthly": 6
        },
        "check_days": 3,
        "read_data_days": 14,
        "window_hours": 30
      }
    ]
  },
  "nodes": {
    "enabled": true,
    "listen": "127.0.0.1:9766"
  },
  "policy": {
    "max_runs_per_hour": 30,
    "max_pending_irreversible": 2,
    "approval_timeout_hours": 12
  },
  "housekeeping": {
    "enabled": true,
    "every_hours": 24,
    "dry_run": false,
    "cpu_percent": 90,
    "rss_mb": 4096,
    "min_age_minutes": 30
  },
  "schedules": {
    "enabled": true,
    "jitter_minutes": 5,
    "keep_days": 14,
    "keep_runs": 50,
    "max_total_mb": 100,
    "max_log_kb": 512
  }
}
