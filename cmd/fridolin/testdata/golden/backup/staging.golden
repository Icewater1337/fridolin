	{
	  "version": 1,
	  "id": "main",
	  "name": "Main",
	  "routing": {
	    "handles_dms": true,
	    "default": true,
	    "groups": [
	      "120363000000000000@g.us"
	    ]
	  },
	  "prompt_file": "brain-prompt.md",
	  "observe": "history",
	  "approvals": "ask",
	  "backup": {
	    "enabled": true,
	    "exclude": [
	      "node_modules/",
	      "*.log",
	      "- private.txt"
	    ]
	  },
	  "calendar": {
	    "account": "you@example.com",
	    "calendars": [
	      "you@example.com",
	      "team@example.com"
	    ],
	    "default": "you@example.com"
	  }
	}
