{
  "_comment": "Edit this in the dashboard (fridolin open). Every option: docs/CONFIGURATION.md",
  "allow_any_dm": false,
  "allowed_groups": [],
  "allowed_numbers": [],
  "backup": {
    "enabled": false
  },
  "brain_mode": true,
  "brain_model": "",
  "claude_path": "/opt/claude/bin/claude",
  "core": {
    "lease": {
      "enabled": false
    },
    "tailnet": {
      "enabled": false
    }
  },
  "dangerously_skip_permissions": true,
  "dashboard": {},
  "data_dir": "~/.fridolin",
  "debounce": {},
  "housekeeping": {},
  "http_listen": "127.0.0.1:8765",
  "ingest": {
    "enabled": false
  },
  "nodes": {
    "enabled": false
  },
  "otp_guard": true,
  "plaud": {
    "enabled": false
  },
  "policy": {},
  "queue": {},
  "sandbox": {
    "allow_paths": [],
    "deny_paths": [],
    "enabled": "<ENABLED>"
  },
  "schedules": {},
  "script_api": {
    "tokenless_send": false
  },
  "startup_checks": {},
  "timezone": "Europe/Zurich",
  "triggers": [
    "@claude"
  ],
  "vault": {
    "enabled": false
  },
  "version": 2,
  "viewer": false
}
