$ fridolin core start
  /usr/local/bin/docker compose -f <COMPOSE> up -d
    PATH=/usr/bin:/bin
    HOME=/Users/you
    FRIDOLIN_IMAGE=fridolin-core
    FRIDOLIN_VERSION=v1.4.0-dirty
