# The build context of container/Dockerfile is the repository. Only what the
# image builds from goes in: never a config, database, token or brain folder
# that happens to lie in the checkout.
*
!go.mod
!go.sum
!cmd/
!internal/
!examples/
!web/
!site/
!tools/*.py
!container/
!plaud-android/
**/testdata/
**/*_test.go
site/node_modules/
web/test/
web/node_modules/
plaud-android/.gradle/
plaud-android/build/
plaud-android/app/build/
plaud-android/app/libs/
plaud-android/local.properties
**/*.apk
