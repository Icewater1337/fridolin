# Editor settings that match the files as they are: tabs where gofmt and
# make insist on them, four spaces for Python, two for everything else
# (the dashboard, shell scripts, YAML, JSON, Markdown).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.go,go.mod,Makefile}]
indent_style = tab

[*.py]
indent_size = 4

[deploy/launchd.plist.template]
indent_size = 4
