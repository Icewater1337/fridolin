# The image's Python (/opt/fridolin/venv, first on PATH): what brains' tools
# import, pinned with hashes in requirements.lock. Regenerate the lock with
# `make container-python-lock` after changing this file.
#
# Local transcription with tools/transcribe.py (and scripts like it): the
# same ranges as tools/requirements-transcription.txt. torch comes from the
# PyTorch CPU index (the image has no GPU; PyPI's x86_64 torch would pull
# in CUDA).
-r ../../tools/requirements-transcription.txt
# The owner's scripts pass torch_dtype, which transformers 5 dropped; the
# Mac runs 4.57.
transformers<5
# Google Calendar from scripts that talk to Google themselves (the bridge's
# own calendar needs none of these).
google-auth>=2.0,<3
google-auth-oauthlib>=1.0,<2
google-api-python-client>=2.0,<3
# YouTube transcripts.
youtube-transcript-api>=1.0,<2
yt-dlp
