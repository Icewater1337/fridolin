(version 1)
(allow default)

;; 1. Writing is denied everywhere; this brain's own places are allowed below
(deny file-write* (subpath "/"))
(allow file-write* (literal "/dev/null"))
(allow file-write* (literal "/dev/zero"))
(allow file-write* (literal "/dev/dtracehelper"))
(allow file-write* (subpath "/dev/fd"))

;; 2. Private places: not readable, unless allowed below
(deny file-read* (subpath "<HOME>/.ssh"))
(deny file-read* (subpath "<HOME>/.gnupg"))
(deny file-read* (subpath "<HOME>/.aws"))
(deny file-read* (subpath "<HOME>/.config/gh"))
(deny file-read* (subpath "<HOME>/.config/gcloud"))
(deny file-read* (subpath "<HOME>/.config/rclone"))
(deny file-read* (subpath "<HOME>/.config/fridolin"))
(deny file-read* (subpath "<HOME>/.config/whatsapp-claude-bridge"))
(deny file-read* (subpath "<HOME>/Library/Logs/fridolin"))
(deny file-read* (subpath "<HOME>/Library/Logs/whatsapp-claude-bridge"))
(deny file-read* (subpath "<HOME>/Documents"))
(deny file-read* (subpath "<HOME>/Downloads"))
(deny file-read* (subpath "<HOME>/Desktop"))
(deny file-read* (subpath "<HOME>/Movies"))
(deny file-read* (subpath "<HOME>/Music"))
(deny file-read* (subpath "<HOME>/Pictures"))
(deny file-read* (subpath "<HOME>/Library/Mail"))
(deny file-read* (subpath "<HOME>/Library/Messages"))
(deny file-read* (subpath "<HOME>/Library/Calendars"))
(deny file-read* (subpath "<HOME>/Library/Cookies"))
(deny file-read* (subpath "<HOME>/Library/Application Support/AddressBook"))
(deny file-read* (subpath "<HOME>/Library/Application Support/Notes"))
(deny file-read* (subpath "<HOME>/Library/Application Support/Google"))
(deny file-read* (subpath "<HOME>/Library/Application Support/Firefox"))
(deny file-read* (subpath "<HOME>/Library/Application Support/BraveSoftware"))
(deny file-read* (subpath "<HOME>/Library/Application Support/Arc"))
(deny file-read* (subpath "<HOME>/Library/Application Support/Chromium"))
(deny file-read* (subpath "<HOME>/Library/Safari"))
(deny file-read* (subpath "<HOME>/Library/Containers"))
(deny file-read* (subpath "<HOME>/Library/Group Containers"))
(deny file-read* (regex "^<HOME>/Library/Application Support/(Microsoft Edge|Vivaldi|com\\.operasoftware\\.Opera)"))
(deny file-read* (literal "<HOME>/.claude/history.jsonl"))
(deny file-read* (literal "<HOME>/.git-credentials"))
(deny file-read* (literal "<HOME>/.config/git/credentials"))
(deny file-read* (literal "<HOME>/.netrc"))
(deny file-read* (literal "<HOME>/.zsh_history"))
(deny file-read* (literal "<HOME>/.bash_history"))
(deny file-read* (subpath "<HOME>/.claude"))
(deny file-read* (literal "<HOME>/.claude.json"))
(deny file-read* (regex "^<HOME>/\\.claude\\.json\\.[^/]*$"))
(deny file-read* (subpath "<HOME>/.plaud"))
(deny file-read* (literal "<HOME>/.gitconfig"))
(deny file-read* (literal "<HOME>/.gitconfig-work"))
(deny file-read* (literal "<HOME>/.config/git/config"))
(deny file-read* (subpath "<HOME>/.config/git"))

;; 3. This brain's own folder, and allow_paths
(allow file-read* (subpath "<HOME>/main"))
(allow file-write* (subpath "<HOME>/main"))

;; 4. Kept from every brain, whatever is allowed above
(deny file-read* (subpath "<HOME>/.fridolin"))
(deny file-write* (subpath "<HOME>/.fridolin"))
(deny file-read* (subpath "<HOME>/.whatsapp-claude-bridge"))
(deny file-write* (subpath "<HOME>/.whatsapp-claude-bridge"))
(deny file-read* (subpath "<HOME>/.fridolin/media"))
(deny file-write* (subpath "<HOME>/.fridolin/media"))
(deny file-read* (literal "<HOME>/.fridolin/bridge.db"))
(deny file-write* (literal "<HOME>/.fridolin/bridge.db"))
(deny file-read* (literal "<HOME>/.fridolin/bridge.db-wal"))
(deny file-write* (literal "<HOME>/.fridolin/bridge.db-wal"))
(deny file-read* (literal "<HOME>/.fridolin/bridge.db-shm"))
(deny file-write* (literal "<HOME>/.fridolin/bridge.db-shm"))
(deny file-read* (literal "<HOME>/.fridolin/bridge.db-journal"))
(deny file-write* (literal "<HOME>/.fridolin/bridge.db-journal"))
(deny file-read* (literal "<ROOT>/config.json"))
(deny file-write* (literal "<ROOT>/config.json"))
(deny file-read* (literal "<ROOT>/config.json.bak"))
(deny file-write* (literal "<ROOT>/config.json.bak"))
(deny file-read* (literal "<ROOT>/.env"))
(deny file-write* (literal "<ROOT>/.env"))
(deny file-read* (regex "^<ROOT>/\\.config\\.json\\.[^/]*\\.tmp$"))
(deny file-write* (regex "^<ROOT>/\\.config\\.json\\.[^/]*\\.tmp$"))
(deny file-read* (subpath "<HOME>/Library/Keychains"))
(deny file-read* (literal "<HOME>/.claude/CLAUDE.md"))
(deny file-read* (subpath "<HOME>/.claude/rules"))
(deny file-read* (literal "<HOME>/CLAUDE.md"))
(deny file-read* (literal "<HOME>/CLAUDE.local.md"))
(deny file-read* (literal "<ROOT>/CLAUDE.md"))
(deny file-read* (literal "<ROOT>/CLAUDE.local.md"))
(deny file-read* (subpath "<ROOT>/.claude"))
(deny file-read* (literal "<ABOVE>/CLAUDE.md"))  [×each folder above]
(deny file-read* (literal "<ABOVE>/CLAUDE.local.md"))  [×each folder above]
(deny file-read* (subpath "<ABOVE>/.claude"))  [×each folder above]
(deny file-read* (literal "/CLAUDE.md"))
(deny file-read* (literal "/CLAUDE.local.md"))
(deny file-read* (subpath "/.claude"))
(deny file-write* (literal "<HOME>/.gitconfig"))
(deny file-write* (literal "<HOME>/.gitconfig-work"))
(deny file-write* (literal "<HOME>/.config/git/config"))
(deny file-write* (subpath "<HOME>/.config/git"))
(deny file-write* (literal "<ROOT>/bin/fridolin"))
(deny file-write* (literal "<HOME>/.local/bin/rclone"))
(deny file-write* (subpath "<HOME>/.nvm/versions/node"))
(deny file-write* (subpath "<HOME>/.local/bin"))

;; 5. This brain's media inbox, state and brain API tokens, and a shared Plaud login
(allow file-read* (subpath "<HOME>/.fridolin/media/main"))
(allow file-write* (subpath "<HOME>/.fridolin/media/main"))
(allow file-read* (subpath "<HOME>/.fridolin/brains/main"))
(allow file-write* (subpath "<HOME>/.fridolin/brains/main"))
(allow file-read* (subpath "<HOME>/.fridolin/run-tokens/main"))
(allow file-read-metadata (literal "<HOME>"))
(allow file-read-metadata (literal "<ROOT>"))
(allow file-read-metadata (literal "<ABOVE>"))  [×each folder above]
(allow file-read-metadata (literal "/"))
(allow file-read-metadata (literal "<HOME>/.fridolin/media"))
(allow file-read-metadata (literal "<HOME>/.fridolin"))
(allow file-read-metadata (literal "<HOME>/.fridolin/brains"))

;; 6. Inside this brain's own places: what stays closed, and the folders themselves
(deny file-read* (literal "<HOME>/.fridolin/bridge.db"))
(deny file-write* (literal "<HOME>/.fridolin/bridge.db"))
(deny file-read* (literal "<HOME>/.fridolin/bridge.db-wal"))
(deny file-write* (literal "<HOME>/.fridolin/bridge.db-wal"))
(deny file-read* (literal "<HOME>/.fridolin/bridge.db-shm"))
(deny file-write* (literal "<HOME>/.fridolin/bridge.db-shm"))
(deny file-read* (literal "<HOME>/.fridolin/bridge.db-journal"))
(deny file-write* (literal "<HOME>/.fridolin/bridge.db-journal"))
(deny file-write* (literal "<HOME>/.fridolin/brains/main"))
(deny file-write* (literal "<HOME>/.fridolin/brains/main/cache"))
(deny file-write* (literal "<HOME>/.fridolin/brains/main/claude"))
(deny file-write* (literal "<HOME>/.fridolin/brains/main/tmp"))
(deny file-write* (literal "<HOME>/.fridolin/media/main"))
(deny file-write* (literal "<HOME>/main"))

;; 7. Starting code outside the sandbox
(deny process-exec (literal "/bin/launchctl"))
(deny process-exec (literal "/usr/bin/open"))
(deny process-exec (literal "/usr/bin/osascript"))
(deny appleevent-send)
(deny lsopen)
(deny network-outbound (remote unix-socket (subpath "<HOME>")))
(deny network-outbound (remote unix-socket (subpath "<ROOT>/tmp/tmux-<UID>")))
(deny network-outbound (remote unix-socket (subpath "<ROOT>/tmp")))
(allow network-outbound (remote unix-socket (subpath "<HOME>/main")))
(allow network-outbound (remote unix-socket (subpath "<HOME>/.fridolin/brains/main")))
<TIME> config: group 120363000000000000@g.us has no group_members entry: only allowed_numbers can start runs there, and what other members write is not read; an entry of ["*"] for it lets every member in, as before, or list their numbers
