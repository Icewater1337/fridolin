(version 1)
(allow default)

;; Cross-session state, credentials, and personal data stores
(deny file-read* (subpath "<HOME>/.ssh"))
(deny file-write* (subpath "<HOME>/.ssh"))
(deny file-read* (subpath "<HOME>/.gnupg"))
(deny file-write* (subpath "<HOME>/.gnupg"))
(deny file-read* (subpath "<HOME>/.aws"))
(deny file-write* (subpath "<HOME>/.aws"))
(deny file-read* (subpath "<HOME>/.config/gh"))
(deny file-write* (subpath "<HOME>/.config/gh"))
(deny file-read* (subpath "<HOME>/.config/gcloud"))
(deny file-write* (subpath "<HOME>/.config/gcloud"))
(deny file-read* (subpath "<HOME>/.config/rclone"))
(deny file-write* (subpath "<HOME>/.config/rclone"))
(deny file-read* (subpath "<HOME>/.config/fridolin"))
(deny file-write* (subpath "<HOME>/.config/fridolin"))
(deny file-read* (subpath "<HOME>/.config/whatsapp-claude-bridge"))
(deny file-write* (subpath "<HOME>/.config/whatsapp-claude-bridge"))
(deny file-read* (subpath "<HOME>/Library/Logs/fridolin"))
(deny file-write* (subpath "<HOME>/Library/Logs/fridolin"))
(deny file-read* (subpath "<HOME>/Library/Logs/whatsapp-claude-bridge"))
(deny file-write* (subpath "<HOME>/Library/Logs/whatsapp-claude-bridge"))
(deny file-read* (subpath "<HOME>/Documents"))
(deny file-write* (subpath "<HOME>/Documents"))
(deny file-read* (subpath "<HOME>/Downloads"))
(deny file-write* (subpath "<HOME>/Downloads"))
(deny file-read* (subpath "<HOME>/Desktop"))
(deny file-write* (subpath "<HOME>/Desktop"))
(deny file-read* (subpath "<HOME>/Movies"))
(deny file-write* (subpath "<HOME>/Movies"))
(deny file-read* (subpath "<HOME>/Music"))
(deny file-write* (subpath "<HOME>/Music"))
(deny file-read* (subpath "<HOME>/Pictures"))
(deny file-write* (subpath "<HOME>/Pictures"))
(deny file-read* (subpath "<HOME>/Library/Mail"))
(deny file-write* (subpath "<HOME>/Library/Mail"))
(deny file-read* (subpath "<HOME>/Library/Messages"))
(deny file-write* (subpath "<HOME>/Library/Messages"))
(deny file-read* (subpath "<HOME>/Library/Calendars"))
(deny file-write* (subpath "<HOME>/Library/Calendars"))
(deny file-read* (subpath "<HOME>/Library/Cookies"))
(deny file-write* (subpath "<HOME>/Library/Cookies"))
(deny file-read* (subpath "<HOME>/Library/Application Support/AddressBook"))
(deny file-write* (subpath "<HOME>/Library/Application Support/AddressBook"))
(deny file-read* (subpath "<HOME>/Library/Application Support/Notes"))
(deny file-write* (subpath "<HOME>/Library/Application Support/Notes"))
(deny file-read* (subpath "<HOME>/Library/Application Support/Google"))
(deny file-write* (subpath "<HOME>/Library/Application Support/Google"))
(deny file-read* (subpath "<HOME>/Library/Application Support/Firefox"))
(deny file-write* (subpath "<HOME>/Library/Application Support/Firefox"))
(deny file-read* (subpath "<HOME>/Library/Application Support/BraveSoftware"))
(deny file-write* (subpath "<HOME>/Library/Application Support/BraveSoftware"))
(deny file-read* (subpath "<HOME>/Library/Application Support/Arc"))
(deny file-write* (subpath "<HOME>/Library/Application Support/Arc"))
(deny file-read* (subpath "<HOME>/Library/Application Support/Chromium"))
(deny file-write* (subpath "<HOME>/Library/Application Support/Chromium"))
(deny file-read* (subpath "<HOME>/Library/Safari"))
(deny file-write* (subpath "<HOME>/Library/Safari"))
(deny file-read* (subpath "<HOME>/Library/Containers"))
(deny file-write* (subpath "<HOME>/Library/Containers"))
(deny file-read* (subpath "<HOME>/Library/Group Containers"))
(deny file-write* (subpath "<HOME>/Library/Group Containers"))
(deny file-read* (regex "^<HOME>/Library/Application Support/(Microsoft Edge|Vivaldi|com\\.operasoftware\\.Opera)"))
(deny file-write* (regex "^<HOME>/Library/Application Support/(Microsoft Edge|Vivaldi|com\\.operasoftware\\.Opera)"))
(deny file-read* (literal "<HOME>/.claude/history.jsonl"))
(deny file-write* (literal "<HOME>/.claude/history.jsonl"))
(deny file-read* (literal "<HOME>/.git-credentials"))
(deny file-write* (literal "<HOME>/.git-credentials"))
(deny file-read* (literal "<HOME>/.netrc"))
(deny file-write* (literal "<HOME>/.netrc"))
(deny file-read* (literal "<HOME>/.zsh_history"))
(deny file-write* (literal "<HOME>/.zsh_history"))
(deny file-read* (literal "<HOME>/.bash_history"))
(deny file-write* (literal "<HOME>/.bash_history"))
(deny file-read* (subpath "<HOME>/.claude/projects"))
(deny file-write-unlink (subpath "<HOME>/.claude/projects"))
(deny file-read* (subpath "<HOME>/.claude/sessions"))
(deny file-write-unlink (literal "<HOME>/.claude/sessions"))
(deny file-write-create (require-all (literal "<HOME>/.claude/sessions") (vnode-type SYMLINK)))
(deny file-write-create (require-all (regex "^<HOME>/\\.claude/projects(/.*)?$") (vnode-type SYMLINK)))
(deny file-write-create (require-all (regex "^<HOME>/\\.claude/sessions(/.*)?$") (vnode-type SYMLINK)))
(deny file-read* (subpath "<HOME>/.plaud"))
(deny file-write* (subpath "<HOME>/.plaud"))

;; Loaded or run outside this sandbox: readable, never writable
(deny file-write* (subpath "<HOME>/.claude/hooks"))
(deny file-write* (subpath "<HOME>/.claude/rules"))
(deny file-write* (subpath "<HOME>/.claude/agents"))
(deny file-write* (subpath "<HOME>/.claude/commands"))
(deny file-write* (subpath "<HOME>/.claude/skills"))
(deny file-write* (subpath "<HOME>/.claude/plugins"))
(deny file-write* (subpath "<HOME>/.claude/output-styles"))
(deny file-write* (subpath "<HOME>/Library/LaunchAgents"))
(deny file-write* (subpath "<HOME>/.config/fish"))
(deny file-write* (subpath "<HOME>/.config/tmux"))
(deny file-write* (literal "<HOME>/.claude/settings.json"))
(deny file-write* (literal "<HOME>/.claude/settings.local.json"))
(deny file-write* (literal "<HOME>/.claude/CLAUDE.md"))
(deny file-write* (literal "<HOME>/.zshenv"))
(deny file-write* (literal "<HOME>/.zprofile"))
(deny file-write* (literal "<HOME>/.zshrc"))
(deny file-write* (literal "<HOME>/.zlogin"))
(deny file-write* (literal "<HOME>/.zlogout"))
(deny file-write* (literal "<HOME>/.bash_profile"))
(deny file-write* (literal "<HOME>/.bash_login"))
(deny file-write* (literal "<HOME>/.bashrc"))
(deny file-write* (literal "<HOME>/.profile"))
(deny file-write* (literal "<HOME>/.tmux.conf"))
(deny file-write* (literal "<ABOVE>/CLAUDE.md"))  [×each folder above]
(deny file-write* (literal "<ABOVE>/CLAUDE.local.md"))  [×each folder above]
(deny file-write* (literal "<ABOVE>/.mcp.json"))  [×each folder above]
(deny file-write* (subpath "<ABOVE>/.claude"))  [×each folder above]
(deny file-write* (literal "<ROOT>/CLAUDE.md"))
(deny file-write* (literal "<ROOT>/CLAUDE.local.md"))
(deny file-write* (literal "<ROOT>/.mcp.json"))
(deny file-write* (subpath "<ROOT>/.claude"))
(deny file-write* (literal "<ROOT>/elsewhere/CLAUDE.md"))
(deny file-write* (literal "<ROOT>/elsewhere/CLAUDE.local.md"))
(deny file-write* (literal "<ROOT>/elsewhere/.mcp.json"))
(deny file-write* (subpath "<ROOT>/elsewhere/.claude"))
(deny file-write* (literal "<HOME>/CLAUDE.md"))
(deny file-write* (literal "<HOME>/CLAUDE.local.md"))
(deny file-write* (literal "<HOME>/.mcp.json"))
(deny file-write* (literal "<HOME>/brains/CLAUDE.md"))
(deny file-write* (literal "<HOME>/brains/CLAUDE.local.md"))
(deny file-write* (literal "<HOME>/brains/.mcp.json"))
(deny file-write* (subpath "<HOME>/brains/.claude"))
(deny file-write* (regex "^<HOME>/\\.claude/projects/[^/]+/memory(/.*)?$"))

;; The bridge, its tools, its checkout and the programs it runs: never writable
(deny file-write* (literal "<ROOT>/bin/fridolin"))
(deny file-write* (literal "<HOME>/.local/bin/rclone"))
(deny file-write* (subpath "<HOME>/.nvm/versions/node"))

;; Git configuration: readable, never writable
(deny file-write* (literal "<HOME>/.gitconfig"))
(deny file-write* (literal "<HOME>/.gitconfig-work"))
(deny file-write* (subpath "<HOME>/.config/git"))

;; Other brains' working trees
(deny file-read* (subpath "<ROOT>/elsewhere/work"))
(deny file-write* (subpath "<ROOT>/elsewhere/work"))
(deny file-read* (subpath "<HOME>/brains/family"))
(deny file-write* (subpath "<HOME>/brains/family"))

;; Bridge runtime data (media staging re-allowed below)
(deny file-read* (subpath "<HOME>/.fridolin"))
(deny file-write* (subpath "<HOME>/.fridolin"))
(deny file-read* (subpath "<HOME>/.whatsapp-claude-bridge"))
(deny file-write* (subpath "<HOME>/.whatsapp-claude-bridge"))
(allow file-read* (subpath "<HOME>/.fridolin/media"))
(allow file-write* (subpath "<HOME>/.fridolin/media"))
(deny file-read* (literal "<HOME>/.fridolin/bridge.db"))
(deny file-write* (literal "<HOME>/.fridolin/bridge.db"))
(deny file-read* (literal "<HOME>/.fridolin/bridge.db-wal"))
(deny file-write* (literal "<HOME>/.fridolin/bridge.db-wal"))
(deny file-read* (literal "<HOME>/.fridolin/bridge.db-shm"))
(deny file-write* (literal "<HOME>/.fridolin/bridge.db-shm"))
(deny file-read* (literal "<HOME>/.fridolin/bridge.db-journal"))
(deny file-write* (literal "<HOME>/.fridolin/bridge.db-journal"))
(deny file-read* (literal "<ROOT>/config.json"))
(deny file-write* (literal "<ROOT>/config.json"))
(deny file-read* (literal "<ROOT>/config.json.bak"))
(deny file-write* (literal "<ROOT>/config.json.bak"))
(deny file-read* (literal "<ROOT>/.env"))
(deny file-write* (literal "<ROOT>/.env"))
(deny file-read* (regex "^<ROOT>/\\.config\\.json\\.[^/]*\\.tmp$"))
(deny file-write* (regex "^<ROOT>/\\.config\\.json\\.[^/]*\\.tmp$"))

;; This brain's brain API tokens
(allow file-read* (subpath "<HOME>/.fridolin/run-tokens/main"))

;; Folders above the denied paths: not renamable or removable
(deny file-write* (literal "<ABOVE>"))  [×each folder above]
(deny file-write* (literal "<ROOT>"))
(deny file-write* (literal "<ROOT>/bin"))
(deny file-write* (literal "<ROOT>/elsewhere"))
(deny file-write* (literal "<HOME>"))
(deny file-write-unlink (literal "<HOME>/.claude"))
(deny file-write-create (require-all (literal "<HOME>/.claude") (vnode-type SYMLINK)))
(deny file-write* (literal "<HOME>/.config"))
(deny file-write* (literal "<HOME>/.fridolin"))
(deny file-write* (literal "<HOME>/.local"))
(deny file-write* (literal "<HOME>/.local/bin"))
(deny file-write* (literal "<HOME>/.nvm"))
(deny file-write* (literal "<HOME>/.nvm/versions"))
(deny file-write* (literal "<HOME>/Library"))
(deny file-write* (literal "<HOME>/Library/Application Support"))
(deny file-write* (literal "<HOME>/Library/Logs"))
(deny file-write* (literal "<HOME>/brains"))

;; This brain's own folder
(allow file-read* (subpath "<HOME>/brains/main"))
(allow file-write* (subpath "<HOME>/brains/main"))
(deny file-write* (literal "<HOME>/brains/main"))
