// TypeScript's checker on the dashboard, with nothing built: the modules
// stay the plain ES modules the bridge serves, and their types come from
// JSDoc (@param, @typedef, @import) and the declarations in types/, which
// are never served. `make typecheck-web` runs it with the TypeScript the
// Makefile pins, through npx; test/tsconfig.json checks the tests.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "esnext",
    // Relative imports with their .js, as the browser loads them.
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    // The browser's globals only: node's are the tests' (test/tsconfig.json).
    "types": [],
    "skipLibCheck": true,

    // Strictness. TypeScript 7 turns "strict" on unless told otherwise;
    // here it is off, and the options of it that the code passes today
    // are on. Turn these on next, one at a time, fixing what each reports
    // (with real types, or a @ts-expect-error that says why), and add each
    // to the options below once it passes:
    //
    // 1. strictNullChecks: null and undefined are their own types (about
    //    320 errors today, two thirds of them "possibly null", mostly
    //    querySelector() results and data that may not have come yet). It
    //    makes noUncheckedIndexedAccess and strictPropertyInitialization
    //    possible after it.
    // 2. Then "strict": true in place of the single options, and
    //    exactOptionalPropertyTypes if it is worth it.
    "strict": false,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // A caught value is unknown: lib/errors.js and errorStatus() in
    // app/api.js narrow it (its message, its name, an ApiError's status).
    "useUnknownInCatchVariables": true,
    // Every parameter and variable has a type, written or inferred.
    "noImplicitAny": true
  },
  "include": ["assets/**/*.js", "types/**/*.d.ts"]
}
