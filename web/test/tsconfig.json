// The tests, with ../tsconfig.json's options: they run under node with
// the fake DOM (fake-dom.js), which fake-dom-globals.d.ts describes where
// it differs from a browser's. The modules they import are checked here
// too, against that DOM; ../tsconfig.json checks them against a browser's.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Found in npx's cache: make typecheck-web passes --typeRoots.
    "types": ["node"],
    // The tests are not held to all of "strict" yet: they run against the
    // fake DOM, where most annotations would be casts. They follow in
    // steps of their own (about 550 noImplicitAny errors today).
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": ["**/*.js", "**/*.d.ts", "../assets/**/*.js", "../types/**/*.d.ts"]
}
