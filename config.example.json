{
  "_comment": "You normally never edit this: the dashboard (./fridolin open) does. Every option: docs/CONFIGURATION.md",

  "allowed_numbers": ["15551234567"],
  "allow_any_dm": false,
  "allowed_groups": ["120363000000000000@g.us"],
  "triggers": ["@claude", {"text": "@c", "match": "start"}],

  "claude_path": "claude",
  "data_dir": "~/.fridolin",

  "brain_mode": true,
  "brain_model": "",
  "brain_effort": "",
  "disallowed_tools": [],
  "brain_dirs": [
    {
      "path": "~/assistant/personal",
      "approved": {
        "version": 1,
        "id": "personal",
        "name": "Personal",
        "routing": {"handles_dms": true, "default": false, "groups": []},
        "backup": {"enabled": true, "exclude": ["node_modules/", "*.log"]}
      }
    },
    {
      "path": "~/assistant/team",
      "approved": {
        "version": 1,
        "id": "team",
        "name": "Team",
        "routing": {"handles_dms": false, "default": true, "groups": ["120363000000000000@g.us"]},
        "backup": {"enabled": true, "exclude": ["node_modules/", "*.log"]}
      }
    }
  ],

  "sandbox": {
    "enabled": true,
    "deny_paths": ["~/clients"],
    "allow_paths": [],
    "git_config": "read"
  },

  "queue": {"mode": "queue", "max_pending": 10, "notify": true},
  "debounce": {"quiet_ms": 2000, "max_wait_ms": 10000},
  "ingest": {"enabled": false},

  "backup": {"enabled": false, "daily_at": "03:30", "keep_versions_days": 30},

  "dangerously_skip_permissions": true,
  "inherit_claude_user_config": false,
  "otp_guard": true,
  "viewer": false,
  "http_listen": "127.0.0.1:8765",
  "max_chunk_size": 3900,
  "max_media_mb": 100,
  "log_level": "info"
}
